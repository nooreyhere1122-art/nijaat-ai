# Copy to deploy/.env on the server and fill in. Never commit the real file.

# The domain the QR codes will point at. Printed stickers encode it, so once a sticker
# is printed this can never change without breaking every code already in the world.
SITE_DOMAIN=nijaat.example.com

# Generate each one with: openssl rand -base64 32
# ENCRYPTION_KEY encrypts every medical profile, report and prescription at rest.
# If you lose it, that data cannot be recovered by anyone, including you. Back it up
# somewhere separate from the server before you put real data in.
JWT_SECRET=
SCAN_SECRET=
ENCRYPTION_KEY=

# SMS. Without these the alerts are only written to the log, so nobody is notified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email for verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NIJAAT AI <no-reply@nijaat.example.com>

# Report summarisation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hospital search. Leave empty to use OpenStreetMap, which needs no key and no billing.
# For Google data and live traffic, enable Places API (New) and Routes API on the key
# and restrict it to this server's IP address.
GOOGLE_MAPS_SERVER_KEY=

# Optional: keep uploaded files outside the database, in a private Vercel Blob store.
# On your own server you do not need this; MongoDB holds them.
BLOB_READ_WRITE_TOKEN=

# Raise if many of your users share one IP (carrier-grade NAT is common in Pakistan).
AUTH_RATE_LIMIT=30
PUBLIC_RATE_LIMIT=60
