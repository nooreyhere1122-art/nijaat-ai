# Caddy gets and renews the HTTPS certificate on its own. HTTPS is not optional here:
# the QR scanner and the prescription camera need a secure context to open the camera.
{$SITE_DOMAIN} {
	encode zstd gzip

	# The API and the web app share one origin, so there is no CORS to configure.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Built assets carry a content hash in the filename, so they can be cached forever.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# These two decide what the browser loads next, so they must never be served stale.
	header /index.html Cache-Control "no-cache"
	header /sw.js Cache-Control "no-cache"

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
