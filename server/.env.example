# Copy to .env and fill in. Generate each secret with: openssl rand -base64 32
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nijaat_ai
CLIENT_URL=http://localhost:5173
# Public address of this API, used for Twilio delivery receipts
API_URL=

# Required in production
JWT_SECRET=
SCAN_SECRET=
ENCRYPTION_KEY=

# SMS: family alerts, physician codes, test messages. Without these, messages are logged only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email: verification and password reset. Without these, links are logged and shown on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NIJAAT AI <no-reply@nijaat.pk>

# Report summarisation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hospital search. Leave empty and the app uses OpenStreetMap: no key, no billing account.
# Set a key only if you want Google's place data and live traffic times; Google requires
# billing to be enabled on the project even inside its free monthly allowance.
# Enable Places API (New) and Routes API on the key, and restrict it to this server's IP.
GOOGLE_MAPS_SERVER_KEY=
# Force a provider: osm or google. Empty picks google when a key is set, otherwise osm.
MAPS_PROVIDER=

OCR_SERVICE_URL=http://127.0.0.1:4100

# Uploaded reports and prescription photos. Leave empty and they are stored in MongoDB,
# which is fine on your own server but will fill a small managed database fast.
# Set a token from a PRIVATE Vercel Blob store to keep them outside the database instead.
# The bytes are encrypted either way, so the store never holds readable medical files.
BLOB_READ_WRITE_TOKEN=

# Timings. The defaults match the SRS.
ALERT_BUFFER_MS=30000
SCAN_SESSION_MINUTES=30
PHYSICIAN_CODE_MINUTES=10
PHYSICIAN_INACTIVITY_MINUTES=5
MAX_UPLOAD_MB=10

# Requests per IP. Raise where many users share one address (carrier-grade NAT).
AUTH_RATE_LIMIT=30
PUBLIC_RATE_LIMIT=60
