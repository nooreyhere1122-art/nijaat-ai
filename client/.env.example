# Copy to .env

# Where the API lives. Leave empty in development: Vite proxies /api to VITE_DEV_API.
VITE_API_URL=
VITE_DEV_API=http://localhost:4000

# Browser key for the hospital map. Leave it empty and the map is drawn with Leaflet and
# OpenStreetMap tiles, which need no key and no billing account.
# Set it only for a Google map, and restrict it to your domain in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=
